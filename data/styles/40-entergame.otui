Button < UIButton
  image-source: /images/landcore/login
  image-border: 0
  image-repeated: false
  image-smooth: true
  text: ""

  $hover:
    image-source: /images/landcore/loginhover

  $pressed:
    image-source: /images/landcore/loginclick


EnterGameWindow < StaticMainWindow
  !text: tr('Enter Game')
  size: 260 190
  padding-top: 36
  padding-left: 16
  padding-right: 16
  padding-bottom: 8
