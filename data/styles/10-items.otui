Item < UIItem
  size: 34 34
  padding: 1
  image-source: /images/ui/item
  font: verdana-11px-rounded
  border-color: white
  color: white

  $disabled:
    color: #646464


DraggedItemWidget < UIItem
  size: 32 32
  phantom: true
  Label
    id: count
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    color: white
    font: verdana-11px-rounded
    shadow: true