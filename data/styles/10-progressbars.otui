ProgressBar < UIProgressBar
  height: 18
  background-color: red
  image-source: /images/ui/progressbar
  image-border: 1
  font: verdana-11px-rounded
  text-offset: 0 2

  $!on:
    visible: false
    margin-top: 0
    margin-bottom: 0
    height: 0

ThickProgressBar < ProgressBar
  image-source: /images/ui/progressbar_thick

LifeProgressBar < UIProgressBar
  height: 18
  background-color: green
  border: 1 black
  font: verdana-11px-rounded
  text-offset: 0 2
  margin: 2
  
ProgressRect < UIProgressRect
  anchors.fill: parent
  phantom: true
  color: white
  background-color: #00000088
  font: verdana-11px-rounded

// Barra de vida elegante com gradiente vermelho vibrante
HealthBar < ProgressBar
  height: 20
  background-color: #C41E3A
  image-source: /images/ui/progressbar
  image-border: 2
  font: verdana-11px-rounded
  text-offset: 0 3
  color: #FFFFFF
  text-shadow: true
  text-shadow-offset: 1 1
  text-shadow-color: #000000AA

// Barra de mana elegante com azul vibrante
ManaBar < ProgressBar
  height: 20
  background-color: #0077DD
  image-source: /images/ui/progressbar
  image-border: 2
  font: verdana-11px-rounded
  text-offset: 0 3
  color: #FFFFFF
  text-shadow: true
  text-shadow-offset: 1 1
  text-shadow-color: #000000AA

// Barra de vida compacta para exibição no topo (abaixo do nome)
TopHealthBar < UIProgressBar
  height: 8
  background-color: #C41E3A
  border: 1 #1A1A1A
  border-color: #222222
  phantom: true

// Barra de mana compacta para exibição no topo (abaixo do nome)
TopManaBar < UIProgressBar
  height: 8
  background-color: #0077DD
  border: 1 #1A1A1A
  border-color: #222222
  phantom: true
