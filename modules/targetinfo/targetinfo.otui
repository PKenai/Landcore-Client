// Target portrait container
UIWidget
  id: targetWindow
  anchors.top: parent.top
  anchors.horizontalCenter: parent.horizontalCenter
  margin-top: 20
  size: 180 170
  draggable: true

  // 1) Barra de vida (fundo, desenhada primeiro)
  UIWidget
    id: health
    background-color: #cf1616
    anchors.bottom: parent.bottom
    anchors.left: parent.horizontalCenter
    margin-left: -88
    margin-bottom: 36
    size: 176 39

  // 2) Fundo do retrato (cobre a barra)
  UIWidget
    id: portraitBg
    image-source: /images/landcore/Target_portrait.png
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter

  // 3) Sprite da criatura (sobre o fundo)
  UICreature
    id: creature
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 12
    margin-left: -5
    size: 59 59
    auto-resize: false

  // Porcentagem de vida (renderizada por último, acima de tudo)
  Label
    id: healthText
    text: "100%"
    color: white
    font: verdana-11px-antialised
    anchors.bottom: health.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: -22
