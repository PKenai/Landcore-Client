OptionPanel
  OptionCheckBox
    id: enableAudio
    margin: 0 0 0 8

    UILabel
      id: label
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 275 30
      !text: tr('Enable audio')
      text-offset: 0 5
      font: verdana-11px-antialised

  OptionCheckBox
    id: enableMusicSound
    margin: 27 0 0 8

    UILabel
      id: label
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 275 30
      !text: tr('Enable music sound')
      text-offset: 0 5
      font: verdana-11px-antialised

  UIWidget
    id: musicSoundVolumeBG
    margin: 27 0 0 2
    height: 15
    font: verdana-11px-antialised
    text: Music volume
    text-align: left
    text-offset: 2 -2

    OptionScrollbar
      id: musicSoundVolume
      anchors.verticalCenter: parent.verticalCenter
      anchors.horizontalCenter: parent.horizontalCenter
      margin: 0 0 0 105
      width: 220
      minimum: 0
      maximum: 100

    Label
      id: musicSoundVolumeLabelBG
      anchors.top: parent.top
      anchors.right: parent.right
      width: 35
      margin: 0 29 0 0
      font: verdana-11px-antialised
      color: #77f558
      @onSetup: |
        local value = modules.client_options.getOption('musicSoundVolume')
        self:setText(tr('%d', value))

