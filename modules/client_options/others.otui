OptionPanel

  OptionCheckBox
    id: showOnlinePlayers
    margin: 27 0 0 8

    UILabel
      id: label
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 275 30
      !text: tr('Show online players')
      !tooltip: tr('Display the number of online players in the upper left corner')
      text-offset: 0 5
      font: verdana-11px-antialised

  OptionCheckBox
    id: showPlayerShadows
    margin: 27 0 0 8

    UILabel
      id: label
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 275 30
      !text: tr('Show player shadows')
      !tooltip: tr('Display shadows under the player character')
      text-offset: 0 5
      font: verdana-11px-antialised