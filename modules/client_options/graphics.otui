OptionPanel
  Label
    text-wrap: false
    font: verdana-11px-antialised
    @onSetup: |
      self:setText(tr("GPU: ") .. g_graphics.getRenderer())      

  Label
    text-wrap: false
    font: verdana-11px-antialised
    @onSetup: |
      self:setText(tr("Version: ") .. g_graphics.getVersion())      

  HorizontalSeparator
    id: separator
    margin: 5 5 5 5

  OptionCheckBox
    id: vsync
    margin: 27 0 0 8

    UILabel
      id: label
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 275 30
      !text: tr('Enable vertical synchronization')
      !tooltip: tr('Limits FPS (usually to 60)')
      text-offset: 0 5
      font: verdana-11px-antialised

  OptionCheckBox
    id: showFps
    margin: 27 0 0 8

    UILabel
      id: label
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 275 30
      !text: tr('Show frame rate')
      text-offset: 0 5
      font: verdana-11px-antialised

  OptionCheckBox
    id: enableLights
    margin: 27 0 0 8

    UILabel
      id: label
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 275 30
      !text: tr('Enable lights')
      text-offset: 0 5
      font: verdana-11px-antialised

  OptionCheckBox
    id: fullscreen
    margin: 27 0 0 8
    tooltip: Ctrl+Shift+F

    UILabel
      id: label
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 275 30
      !text: tr('Fullscreen')
      text-offset: 0 5
      font: verdana-11px-antialised


  Label
    margin: 27 0 0 6
    id: optimizationLevelLabel
    font: verdana-11px-antialised
    !text: tr("Optimization level")

  OptionComboBox
    id: optimizationLevel
    image-source: settings/combobox
    image-size: 200 40
    font: verdana-11px-antialised
    opacity: 0.5
    @onMousePress: |
      addEvent(function()
      local menuStyle = self:getStyleName()
      if self:getStyleName() == 'OptionComboBox' then menuStyle = 'ComboBox' end
      local menu
      if self.menuScroll then
      menu = g_ui.createWidget(menuStyle .. 'PopupScrollMenu')
      menu:setHeight(self.menuHeight)
      if self.menuScrollStep > 0 then
      menu:setScrollbarStep(self.menuScrollStep)
      end
      else
      menu = g_ui.createWidget(menuStyle .. 'PopupMenu')
      end
      menu:setId(self:getId() .. 'PopupMenu')
      for i,v in ipairs(self.options) do
      menu:addOption(v.text, function() self:setCurrentOption(v.text) end)
      end
      menu:setWidth(self:getWidth())
      menu:display({ x = self:getX(), y = self:getY() + self:getHeight() })
      connect(menu, { onDestroy = function() self:setOn(false) end })
      self:setOn(true)
      menu:setWidth(200)
      menu:setImageSource('settings/comboboxActive')
      end)
    @onOptionChange: modules.client_options.setOption(self:getId(), self.currentIndex)
    @onSetup: |
      self:addOption("Automatic")
      self:addOption("None")
      self:addOption("Low")
      self:addOption("Medium")
      self:addOption("High")
      self:addOption("Maximum")

  Label
    !text: tr('High/Maximum optimization level may cause visual defects.')
    margin: 5 0 0 4
    height: 30
    font: verdana-11px-antialised

  UIWidget
    id: backgroundFrameRateBG
    margin: 10 0 0 0
    height: 15
    font: verdana-11px-antialised
    text: Game framerate limit
    text-align: left
    text-offset: 2 -2

    OptionScrollbar
      id: backgroundFrameRate
      anchors.verticalCenter: parent.verticalCenter
      anchors.horizontalCenter: parent.horizontalCenter
      margin: 0 0 0 105
      width: 220
      minimum: 10
      maximum: 201

    Label
      id: backgroundFrameRateLabelBG
      anchors.top: parent.top
      anchors.right: parent.right
      width: 35
      margin: 0 35 0 0
      font: verdana-11px-antialised
      color: #77f558
      @onSetup: |
        local value = modules.client_options.getOption('backgroundFrameRate')
        local text = value
        if value <= 0 or value >= 201 then
          text = 'max'
        end
        self:setText(tr('%s', text))

  UIWidget
    id: ambientLightBG
    margin: 27 0 0 0
    height: 15
    font: verdana-11px-antialised
    text: Ambient light
    text-align: left
    text-offset: 2 -8

    OptionScrollbar
      id: ambientLight
      anchors.verticalCenter: parent.verticalCenter
      anchors.horizontalCenter: parent.horizontalCenter
      margin: 0 0 0 105
      width: 220
      minimum: 0
      maximum: 100

    Label
      id: ambientLightLabelBG
      anchors.top: parent.top
      anchors.right: parent.right
      width: 35
      margin: 0 29 0 0
      font: verdana-11px-antialised
      color: #77f558
      @onSetup: |
        local value = modules.client_options.getOption('ambientLight')
        self:setText(tr('%s%%', value))

  UIWidget
    id: effectOpacityBG
    margin: 27 0 0 0
    height: 15
    font: verdana-11px-antialised
    text: Effect Opacity
    text-align: left
    text-offset: 2 -8

    OptionScrollbar
      id: effectOpacity
      anchors.verticalCenter: parent.verticalCenter
      anchors.horizontalCenter: parent.horizontalCenter
      margin: 0 0 0 105
      width: 220
      minimum: 0
      maximum: 100

    Label
      id: effectOpacityLabelBG
      anchors.top: parent.top
      anchors.right: parent.right
      width: 35
      margin: 0 29 0 0
      font: verdana-11px-antialised
      color: #77f558
      @onSetup: |
        local value = modules.client_options.getOption('effectOpacity')
        self:setText(tr('%s%%', value))

  Label
    id: tips
    margin-top: 20
    text-auto-resize: true
    text-align: left
    text-wrap: true
    !text: tr("If you have FPS issues:\n- Use OpenGL version (_gl)\n- Disable vertical synchronization\n- Set higher optimization level\n- Lower screen resolution\nOr report it on forum: http://otclient.net")
    font: verdana-11px-antialised
    $mobile:
      visible: false

