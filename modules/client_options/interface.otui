OptionPanel

  OptionCheckBox
    id: showPing
    margin: 27 0 0 8

    UILabel
      id: label
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 275 30
      !text: tr('Show connection ping')
      !tooltip: tr('Display connection speed to the server (milliseconds)')
      text-offset: 0 5
      font: poppins-14-px

  OptionCheckBox
    id: displayCreatureShadows
    margin: 27 0 0 8

    UILabel
      id: label
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 275 30
      !text: tr('Display creature shadows')
      text-offset: 0 5
      font: poppins-14-px

  OptionCheckBox
    id: displayNames
    margin: 27 0 0 8

    UILabel
      id: label
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 275 30
      !text: tr('Show player mana bar')
      text-offset: 0 5
      font: poppins-14-px

  OptionCheckBox
    id: displayHealthOnTop
    margin: 27 0 0 8
    $mobile:
      visible: false

    UILabel
      id: label
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 275 30
      !text: tr('Display creature health bars above texts')
      text-offset: 0 5
      font: poppins-14-px

  OptionCheckBox
    id: highlightThingsUnderCursor
    margin: 27 0 0 8

    UILabel
      id: label
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 275 30
      !text: tr('Highlight things under cursor')
      text-offset: 0 5
      font: poppins-14-px

  Label
    margin-top: 3
    id: crosshairLabel
    margin: 27 0 0 8
    !text: tr("Crosshair")
    font: poppins-14-px

  OptionComboBox
    id: crosshair
    margin: 2 0 0 2
    color: white
    text-offset: 18 0
    image-source: settings/combobox
    image-size: 200 40
    opacity: 0.5
    font: poppins-14-px
    @onMousePress: |
      addEvent(function()
      local menuStyle = self:getStyleName()
      if self:getStyleName() == 'OptionComboBox' then menuStyle = 'ComboBox' end
      local menu
      if self.menuScroll then
      menu = g_ui.createWidget(''..menuStyle..'PopupScrollMenu')
      menu:setHeight(self.menuHeight)
      if self.menuScrollStep > 0 then
      menu:setScrollbarStep(self.menuScrollStep)
      end
      else
      menu = g_ui.createWidget(''..menuStyle..'PopupMenu')
      end
      menu:setId(self:getId() .. 'PopupMenu')
      for i,v in ipairs(self.options) do
      menu:addOption(v.text, function() self:setCurrentOption(v.text) end)
      end
      menu:setWidth(self:getWidth())
      menu:display({ x = self:getX(), y = self:getY() + self:getHeight() })
      connect(menu, { onDestroy = function() self:setOn(false) end })
      self:setOn(true)
      menu:setWidth(200)
      menu:setImageSource('settings/comboboxActive')
      menu:setFont('poppins-14-px')
      end)
    @onOptionChange: modules.client_options.setOption(self:getId(), self.currentIndex)
    @onSetup: |
      self:addOption("None")
      self:addOption("Default")
      self:addOption("Full")

  Label
    id: floorFadingLabel
    font: poppins-14-px
    margin: 6 0 0 8

  UIWidget
    id: floorFadingBG
    height: 15
    font: poppins-14-px
    text: Floor Fading
    text-align: left
    text-offset: 4 0

    OptionScrollbar
      id: floorFading
      anchors.verticalCenter: parent.verticalCenter
      anchors.horizontalCenter: parent.horizontalCenter
      margin: 0 0 0 105
      width: 220
      minimum: 0
      maximum: 2000

    Label
      id: floorFadingLabelBG
      anchors.top: parent.top
      anchors.right: parent.right
      width: 50
      margin: 0 13 0 0
      font: poppins-14-px
      color: #77f558

  Label
    id: floorFadingLabel2
    margin-top: 6
    margin: 5 0 0 8
    !text: (tr('Floor fading doesn\'t work with enabled light'))
    font: poppins-14-px
