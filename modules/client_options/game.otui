OptionPanel

  OptionCheckBox
    id: classicControl
    margin: 0 0 0 8

    $mobile:
      visible: false

    UILabel
      id: label
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 275 30
      !text: tr('Classic control')
      text-offset: 0 5
      font: verdana-11px-antialised

  OptionCheckBox
    id: displayText
    margin: 27 0 0 8

    UILabel
      id: label
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 275 30
      !text: tr('Display text messages')
      text-offset: 0 5
      font: verdana-11px-antialised

  OptionCheckBox
    id: wsadWalking
    margin: 27 0 0 8
    $mobile:
      visible: false

    UILabel
      id: label
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 275 30
      !text: tr('Enable WSAD walking')
      text-offset: 0 5
      !tooltip: tr('Disable chat and allow walk using WSAD keys')
      font: verdana-11px-antialised

  OptionCheckBox
    id: smartWalk
    margin: 27 0 0 8

    UILabel
      id: label
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 275 30
      !text: tr('Enable smart walking')
      text-offset: 0 5
      !tooltip: tr('Will detect when to use diagonal step based on the\nkeys you are pressing')
      font: verdana-11px-antialised
      
  Panel
    margin: 27 0 0 4
    height: 30