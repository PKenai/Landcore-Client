UnifiedInventoryWindow < UIWindow
  id: unifiedInventoryWindow
  !text: 
  size: 413 560
  @onClose: modules.game_unified_inventory.onMiniWindowClose()
  
  UIWidget
    id: backgroundImage
    anchors.centerIn: parent
    margin-top: -55
    size: 505 675
    image-source: /images/landcore/inventory
    image-auto-resize: false
  
  Panel
    id: mainPanel
    anchors.fill: parent
    layout:
      type: verticalBox
    padding: 3
    
    Panel
      id: equipmentPanel
      height: 155
      margin-top: -25
      padding: 5
      background-color: #00000000
      border-width: 0
      
      Panel
        id: inventoryPanel
        anchors.fill: parent
        anchors.margins: 5
        
        Item
          id: slot1
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 3
          image-source: /images/game/slots/head
          background-image: /images/landcore/inventoryicon

        Item
          id: slot4
          anchors.top: slot1.bottom
          anchors.horizontalCenter: slot1.horizontalCenter
          margin-top: 3
          image-source: /images/game/slots/body
          background-image: /images/landcore/inventoryicon

        Item
          id: slot7
          anchors.top: slot4.bottom
          anchors.horizontalCenter: slot4.horizontalCenter
          margin-top: 3
          image-source: /images/game/slots/legs
          background-image: /images/landcore/inventoryicon

        Item
          id: slot8
          anchors.top: slot7.bottom
          anchors.horizontalCenter: slot7.horizontalCenter
          margin-top: 3
          image-source: /images/game/slots/feet
          background-image: /images/landcore/inventoryicon

        Item
          id: slot2
          anchors.top: slot1.top
          anchors.right: slot1.left
          margin-top: 13
          margin-right: 5
          image-source: /images/game/slots/neck
          background-image: /images/landcore/inventoryicon

        Item
          id: slot6
          anchors.top: slot2.bottom
          anchors.horizontalCenter: slot2.horizontalCenter
          margin-top: 3
          image-source: /images/game/slots/left-hand
          background-image: /images/landcore/inventoryicon

        Item
          id: slot9
          anchors.top: slot6.bottom
          anchors.horizontalCenter: slot6.horizontalCenter
          margin-top: 3
          image-source: /images/game/slots/finger
          background-image: /images/landcore/inventoryicon
          
        Item
          id: slot3
          anchors.top: slot1.top
          anchors.left: slot1.right
          margin-top: 13
          margin-left: 5
          image-source: /images/game/slots/back
          background-image: /images/landcore/inventoryicon

        Item
          id: slot5
          anchors.top: slot3.bottom
          anchors.horizontalCenter: slot3.horizontalCenter
          margin-top: 3
          image-source: /images/game/slots/right-hand
          background-image: /images/landcore/inventoryicon

        Item
          id: slot10
          anchors.top: slot5.bottom
          anchors.horizontalCenter: slot5.horizontalCenter
          margin-top: 3
          image-source: /images/game/slots/ammo
          background-image: /images/landcore/inventoryicon
    
    Panel
      id: favoritesContainer
      height: 50
      padding: 3
      background-color: #00000000
      border-width: 0
      
      Label
        anchors.top: parent.top
        anchors.left: parent.left
        margin-left: 3
        margin-top: 2
        text: tr('Favorites')
        font: verdana-11px-antialised
        color: #FFFF00
      
      Panel
        id: favoritesPanel
        anchors.fill: parent
        anchors.top: prev.bottom
        margin-top: 2
        layout:
          type: grid
          cell-size: 34 34
          flow: true
          num-columns: 8
    
    Panel
      id: backpackContainer
      size: 0 0
      padding: 3
      background-color: #00000000
      border-width: 0
      
      Panel
        id: backpackPanel
        anchors.fill: parent
        anchors.margins: 3
        layout:
          type: grid
          cell-size: 34 34
          flow: true
          num-columns: 8
