EnterGameWindow
  id: enterGame
  @onEnter: EnterGame.doLogin()
  size: 260 190
  padding-bottom: 8
  !clipping: false

  UIWidget
    id: backgroundImage
    image-source: /images/landcore/backlogin
    image-border: 0
    image-repeated: false
    image-smooth: true
    !clipping: false
    focusable: false
    anchors.fill: parent

  TextEdit
    id: accountNameTextEdit
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    margin-top: 20
    image-source:
    image-border: 0
    background-color: #493E38

  PasswordTextEdit
    id: accountPasswordTextEdit
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 7
    image-source:
    image-border: 0
    background-color: #493E38

  CheckBox
    id: rememberPasswordBox
    !text: tr('Remember password')
    !tooltip: tr('Remember account and password when starts client')
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 3

  UIButton
    id: loginButton
    image-source: /images/landcore/login
    image-border: 0
    image-repeated: false
    image-smooth: true
    image-auto-resize: true
    text: ""
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: prev.bottom
    margin-top: 10
    @onClick: EnterGame.doLogin()
    @onHoverChange: EnterGame.onLoginButtonHover(self)
    @onMousePress: EnterGame.onLoginButtonPress(self)
    @onMouseRelease: EnterGame.onLoginButtonRelease(self)

  Label
    id: serverInfoLabel
    font: verdana-11px-rounded
    anchors.top: prev.top
    anchors.left: parent.left
    margin-top: 5
    color: green
    text-auto-resize: true