ProgressBar < UIProgressBar
  height: 18
  background-color: red
  image-source: /images/ui/progressbar
  image-border: 2
  font: verdana-11px-rounded
  text-offset: 0 2

  $!on:
    visible: false
    margin-top: 0
    margin-bottom: 0
    height: 0

LifeProgressBar < UIProgressBar
  height: 18
  background-color: green
  border: 1 black
  font: verdana-11px-rounded
  text-offset: 0 2
  margin: 2

ProgressRect < UIProgressRect
  anchors.fill: parent
  phantom: true
  color: white
  background-color: #00000088
  font: verdana-11px-rounded

// Barra de vida elegante com visual moderno
HealthBar < ProgressBar
  image-source: /images/ui/progressbarhpmana
  image-border: 3
  height: 20
  background-color: #C41E3A
  font: verdana-11px-rounded
  text-offset: 0 3
  color: #FFFFFF

// Barra de mana elegante com visual moderno
ManaBar < ProgressBar
  image-source: /images/ui/progressbarhpmana
  image-border: 4
  height: 20
  background-color: #3498DB
  font: verdana-11px-rounded
  text-offset: 0 3
  color: #FFFFFF

// Barra de vida compacta para overlay
ElegantHealthBar < UIProgressBar
  height: 10
  background-color: #C41E3A
  border: 1 #0A0A0A
  font: verdana-11px-rounded
  text-offset: 0 0
  color: #FFFFFF
  opacity: 0.95
  phantom: true

// Barra de mana compacta para overlay
ElegantManaBar < UIProgressBar
  height: 10
  background-color: #3498DB
  border: 1 #0A0A0A
  font: verdana-11px-rounded
  text-offset: 0 0
  color: #FFFFFF
  opacity: 0.95
  phantom: true
