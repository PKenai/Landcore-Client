Panel < UIWidget
  phantom: true
  auto-focus: first

ScrollablePanel < UIScrollArea
  phantom: true
  auto-focus: first

FlatPanel < Panel
  image-source: /images/ui/panel_flat
  image-border: 1

ScrollableFlatPanel < ScrollablePanel
  image-source: /images/ui/panel_flat
  image-border: 1

LightFlatPanel < Panel
  image-source: /images/ui/panel_lightflat
  image-border: 1

PanelRoundedSolid < Panel
  image-source: /images/ui/panel_rounded_solid
  image-border: 10

ScrollablePanel < UIScrollArea
  phantom: true
  auto-focus: first

ScrollablePanelFlat < ScrollablePanel
  image-source: /images/ui/panel
  image-border: 10
  border: 1 #3A3939